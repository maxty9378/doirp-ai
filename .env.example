# Specify your API Key selection method, currently supporting `random` and `turn`.
# API_KEY_SELECT_MODE=random

# #######################################
# ########## Security Settings ###########
# #######################################

# Control Content Security Policy headers
# Set to '1' to enable X-Frame-Options and Content-Security-Policy headers
# Default is '0' (enabled)
# ENABLED_CSP=1

# SSRF Protection Settings
# Set to '1' to allow connections to private IP addresses (disable SSRF protection)
# WARNING: Only enable this in trusted environments
# Default is '0' (SSRF protection enabled)
# SSRF_ALLOW_PRIVATE_IP_ADDRESS=0

# Whitelist of allowed private IP addresses (comma-separated)
# Only takes effect when SSRF_ALLOW_PRIVATE_IP_ADDRESS is '0'
# Example: Allow specific internal servers while keeping SSRF protection
# SSRF_ALLOW_IP_ADDRESS_LIST=192.168.1.100,10.0.0.50

# Admin: email that can access Settings → Users (optional; admin is also determined by username maxim.kadochkin)
# NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# #######################################
# ########### Redis Settings ############
# #######################################

# Connection string for self-hosted Redis (Docker/K8s/managed). Use container hostname when running via docker-compose.
# REDIS_URL=redis://localhost:6379

# Optional database index.
# REDIS_DATABASE=0

# Optional authentication for managed Redis.
# REDIS_USERNAME=default
# REDIS_PASSWORD=yourpassword

# Set to '1' to enforce TLS when connecting to managed Redis or rediss:// endpoints.
# REDIS_TLS=0

# Namespace prefix for cache/queue keys.
# REDIS_PREFIX=lobechat

# #######################################
# ######### AI Provider Service #########
# #######################################

# ## OpenAI ###

# you openai api key
OPENAI_API_KEY=sk-xxxxxxxxx

# use a proxy to connect to the OpenAI API
# OPENAI_PROXY_URL=https://api.openai.com/v1

# add your custom model name, multi model separate by comma. for example gpt-3.5-1106,gpt-4-1106
# OPENAI_MODEL_LIST=gpt-3.5-turbo


# ## Azure OpenAI ###

# you can learn azure OpenAI Service on https://learn.microsoft.com/en-us/azure/ai-services/openai/overview
# use Azure OpenAI Service by uncomment the following line

# The API key you applied for on the Azure OpenAI account page, which can be found in the "Keys and Endpoints" section.
# AZURE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The endpoint you applied for on the Azure OpenAI account page, which can be found in the "Keys and Endpoints" section.
# AZURE_ENDPOINT=https://docs-test-001.openai.azure.com

# Azure's API version, follows the YYYY-MM-DD format
# AZURE_API_VERSION=2024-10-21


# ## Anthropic Service ####

# ANTHROPIC_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# use a proxy to connect to the Anthropic API
# ANTHROPIC_PROXY_URL=https://api.anthropic.com


# ## Google AI  ####

# Google (Gemini) API key — used for chat and for the Voice Call / Gemini Live trainer
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: separate API key for TTS/audio (used by /webapi/tts/google and generate-legend-audio). If unset, GOOGLE_API_KEY is used.
# GOOGLE_TTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override Gemini API base URL if direct access is blocked (e.g. region). TTS and voice-call routes use this.
# GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Google Cloud Speech-to-Text for post-call interview transcription.
# Service account JSON with access to Speech-to-Text and temporary Cloud Storage bucket:
# GOOGLE_SPEECH_CREDENTIALS={ "type": "service_account", ... }
# Optional override if project_id is not inside GOOGLE_SPEECH_CREDENTIALS:
# GOOGLE_SPEECH_PROJECT=your-google-cloud-project
# Temporary bucket for post-call interview audio (audio is deleted right after transcription):
# GOOGLE_SPEECH_BUCKET=your-temp-stt-bucket
# Optional Speech-to-Text location/model:
# GOOGLE_SPEECH_LOCATION=global
# GOOGLE_SPEECH_MODEL=latest_long
# Optional: proxy for server requests to Gemini (TTS/API). Example: socks5://127.0.0.1:2080 or http://127.0.0.1:7890
# HTTPS_PROXY=socks5://127.0.0.1:2080
# Voice call trainer — WebSocket proxy (обязательно на продакшене, если регион блокирует прямой доступ).
# Локально по умолчанию API отдаёт wss://apidoirp.ru/voice-call-ws (прокси на VPS). Свой хост: VOICE_CALL_WS_PROXY_DEV=...
# Локальный прокси (:3011): VOICE_CALL_WS_PROXY_URL=ws://localhost:3011
# На Vercel: прокси НЕ запускается — браузер идёт в Google с IP пользователя → часто 1007 "User location is not supported".
# Решение: поднять voice-call-ws-proxy.mts на VPS/Railway/Fly.io (wss через reverse proxy), в Vercel задать:
# VOICE_CALL_WS_PROXY_URL=wss://voice-proxy.yourdomain.com
# На машине с прокси: HTTPS_PROXY=http://USER:PASS@HOST:PORT (или socks5) чтобы исходящий трафик к Google шёл через разрешённый регион.
# Доп. прокси для REST (analyze/debrief/hint, generateContent): через запятую или перевод строки — URL или host:port:user:pass
# VOICE_CALL_HTTP_PROXY_FALLBACKS=http://USER:PASS@HOST:PORT
# VOICE_CALL_WS_PROXY_URL=ws://localhost:3011
# VOICE_CALL_WS_PROXY_DEV=wss://другой-хост/voice-call-ws

# Voice trainer banner override (optional). If empty, default file is:
# /images/voice-call/trainer-banner-current.png
# NEXT_PUBLIC_TRAINING_TP_BANNER_URL=/images/voice-call/trainer-banner-current.png


# ## LiveKit (Voice Call WebRTC) ####

# LiveKit server URL (wss://…). Used by the voice training widget to connect via WebRTC.
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
# LiveKit API key and secret — used by /api/livekit to issue access tokens.
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret


